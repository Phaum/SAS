# Скопируйте в install.env и установите chmod 600 install.env.
# Значения буквальные, без кавычек и shell-подстановок.
PANEL_DOMAIN=panel.example.com
SUB_DOMAIN=vpn.example.com
LETSENCRYPT_EMAIL=admin@example.com
PUBLIC_IP=198.51.100.10

XUI_USERNAME=root
XUI_PASSWORD=replace-with-strong-password
XUI_PANEL_PORT=9999
XUI_SUB_PORT=2096
# Пустое значение создаст случайный путь при установке.
XUI_WEB_BASE_PATH=
XUI_SUB_PATH=/podpiska/
# Пустое значение устанавливает последний стабильный релиз.
XUI_VERSION=
XUI_INSTALL_REF=main

GRAFANA_USERNAME=root
GRAFANA_PASSWORD=replace-with-another-strong-password
LOG_RETENTION=168h

# Необязательно: абсолютный путь к резервной копии x-ui.db на целевом сервере.
RESTORE_XUI_DB=
SKIP_DNS_CHECK=no

LOKI_IMAGE=grafana/loki:3.7.0
GRAFANA_IMAGE=grafana/grafana:13.2.1
ALLOY_IMAGE=grafana/alloy:v1.19.2
